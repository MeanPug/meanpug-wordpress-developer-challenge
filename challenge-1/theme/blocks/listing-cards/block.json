{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "airpnp/listing-cards",
    "title": "AirPnP Listing Cards",
    "description": "Grid of the latest posts, used on the AirPnP front page as the destinations row. Driven by Airpnp\\Front_Page::get_listing_cards() with a 1-hour transient cache.",
    "category": "child-theme-blocks",
    "icon": "grid-view",
    "keywords": ["airpnp", "cards", "listings", "posts"],
    "textdomain": "inf",
    "supports": {
        "anchor": true,
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "limit": {
            "type": "number",
            "default": 3
        }
    },
    "render": "file:./render.php",
    "editorScript": "file:./listing-cards.js"
}
