{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "pugpuggle/case-results",
    "title": "Pug & Puggle: Case Results",
    "description": "Grid of recent case result cards, optionally filtered by practice area.",
    "category": "pug-puggle-blocks",
    "icon": "awards",
    "keywords": ["case", "results", "verdicts"],
    "textdomain": "inf",
    "supports": {
        "align": ["wide", "full"],
        "anchor": true,
        "html": false
    },
    "attributes": {
        "heading": { "type": "string", "default": "Recent Results" },
        "limit": { "type": "number", "default": 6 },
        "practiceArea": { "type": "number", "default": 0 }
    },
    "editorScript": "blocks/case-results-editor-script",
    "render": "file:./case-results.php",
    "example": {
        "attributes": {
            "heading": "Recent Results",
            "limit": 4,
            "practiceArea": 0
        }
    }
}
